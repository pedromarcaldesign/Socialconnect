# --- obrigatório -------------------------------------------------------------
# Postgres (Supabase: Project Settings > Database > Connection string, modo "Transaction" porta 6543)
DATABASE_URL=
# opcional: ligação para as migrações (Supabase: "Session pooler", porta 5432). Se vazio, usa DATABASE_URL.
MIGRATION_DATABASE_URL=
# URL público da app, sem barra no fim (ex.: https://social.purepixel.pt)
APP_URL=https://social.purepixel.pt
# 32 bytes aleatórios em base64: openssl rand -base64 32  (cifra os tokens da Meta e assina URLs)
APP_SECRET=

# --- login e ficheiros (Supabase) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# bucket privado no Supabase Storage
STORAGE_BUCKET=media
# emails que podem entrar sem convite (separados por vírgulas). O primeiro a entrar fica dono.
ALLOWED_EMAILS=

# --- páginas legais (/privacidade, /eliminacao-de-dados) ---------------------
# nome da entidade responsável e email para pedidos de privacidade
LEGAL_ENTITY_NAME=Purepixel
PRIVACY_CONTACT_EMAIL=

# --- Meta (Facebook + Instagram) ---------------------------------------------
# token do System User do Business Manager (não expira)
META_SYSTEM_USER_TOKEN=
# segredo da app da Meta (ativa o appsecret_proof em cada pedido)
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# --- IA ------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# modelo por omissão: claude-opus-5-5
AI_MODEL=

# --- agendamento ---------------------------------------------------------------
# Inngest (recomendado): chaves em app.inngest.com > Manage > Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Alternativa/rede de segurança: um cron chama POST /api/cron/due com "authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- só desenvolvimento e testes ---------------------------------------------
# entra automaticamente com este email (ignorado em produção)
DEV_AUTH_EMAIL=
# 'local' guarda ficheiros em .data/uploads em vez do Supabase
STORAGE_DRIVER=
# APIs simuladas nos testes E2E
META_GRAPH_BASE=
AI_BASE_URL=
